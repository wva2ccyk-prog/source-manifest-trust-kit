{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/source-manifest-trust-kit/acquisition_manifest.schema.json",
  "title": "Direct URL Acquisition Manifest",
  "type": "object",
  "required": ["issue_id", "sources"],
  "properties": {
    "issue_id": {"type": "string", "minLength": 1},
    "analysis_request": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["source_name", "source_type", "mode", "url"],
        "properties": {
          "source_name": {"type": "string", "minLength": 1},
          "source_type": {"type": "string"},
          "mode": {"enum": ["general", "finance"]},
          "url": {"type": "string", "pattern": "^https?://"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": "string"},
          "citation_note": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
